[Unit]
Description=PLANK Wacom tablet Relay
After=network-online.target systemd-udevd.service avahi-daemon.service
Wants=network-online.target avahi-daemon.service

[Service]
Type=simple
User=plank-relay
Group=plank-relay
Environment=PLANK_RELAY_BIND=127.0.0.1
EnvironmentFile=-/etc/default/plank-tablet-relay
ExecStart=/usr/local/libexec/plank-tablet-relay serve --state-dir /var/lib/plank-tablet-relay --bind ${PLANK_RELAY_BIND} --port 28990
Restart=on-failure
RestartSec=2
StateDirectory=plank-tablet-relay
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
